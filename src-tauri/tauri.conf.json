{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xpecs",
  "version": "0.1.0",
  "identifier": "club.skale.xpecs",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xpecs · Skale Club",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B111C"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Skale Club",
    "copyright": "© 2026 Skale Club",
    "homepage": "https://skale.club",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
